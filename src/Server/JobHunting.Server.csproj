<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JobHunting.Server</RootNamespace>
  </PropertyGroup>

  <!-- Builds the React SPA into src/web/dist, so `dotnet run` is the only command a fresh clone needs.
       Incremental: skipped while dist/index.html is newer than every SPA source file.
       The output stays outside this project on purpose: the SDK's static web assets would otherwise
       record the old hashed file names before Vite replaces them, and the build fails. -->
  <ItemGroup>
    <SpaSource Include="..\web\src\**\*;..\web\public\**\*;..\web\*.html;..\web\package.json;..\web\vite.config.ts" />
  </ItemGroup>

  <Target Name="BuildSpa" BeforeTargets="BeforeBuild" Inputs="@(SpaSource)" Outputs="..\web\dist\index.html"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="..\web" Condition="!Exists('..\web\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="..\web" />
  </Target>

</Project>
